define threaded_world_prove
	rm -rf '$(abs_top_srcdir)/$(1)'/tmp_check
	$(MKDIR_P) '$(abs_top_srcdir)/$(1)'/tmp_check/log
	cd '$(abs_top_srcdir)/$(1)' && \
	  TESTLOGDIR='$(abs_top_srcdir)/$(1)'/tmp_check/log \
	  TESTDATADIR='$(abs_top_srcdir)/$(1)'/tmp_check \
	  PATH='$(abs_top_builddir)'/tmp_install$(bindir):'$(abs_top_srcdir)/$(1)':$$PATH \
	  $(call add_to_path,$(strip $(ld_library_path_var)),$(abs_top_builddir)/tmp_install$(libdir)) \
	  INITDB_TEMPLATE='$(abs_top_builddir)'/tmp_install/initdb-template \
	  TEMP_CONFIG='$(THREADED_WORLD_TAP_CONFIG)' \
	  PG_TEST_EXTRA='$(PG_TEST_EXTRA)' \
	  PGPORT=65432 \
	  top_builddir='$(abs_top_builddir)' \
	  PG_REGRESS='$(abs_top_builddir)'/src/test/regress/pg_regress \
	  REGRESS_SHLIB='$(abs_top_builddir)'/src/test/regress/regress$(DLSUFFIX) \
	  TEST_EXT_LIB='$(THREADED_WORLD_TEST_EXT_LIB)' \
	  share_contrib_dir='$(abs_top_builddir)'/tmp_install$(datadir)/$(datamoduledir) \
	  GMAKE='$(MAKE)' \
	  with_icu='$(with_icu)' \
	  with_ssl='$(with_ssl)' \
	  with_gssapi='$(with_gssapi)' \
	  with_krb_srvnam='$(with_krb_srvnam)' \
	  with_readline='$(with_readline)' \
	  with_ldap='$(with_ldap)' \
	  with_libcurl='$(with_libcurl)' \
	  with_python='$(with_python)' \
	  enable_injection_points='$(enable_injection_points)' \
	  OPENSSL='$(OPENSSL)' \
	  PYTHON='$(PYTHON)' \
	  TAR='$(TAR)' \
	  GZIP_PROGRAM='$(GZIP)' \
	  LZ4='$(LZ4)' \
	  ZSTD='$(ZSTD)' \
	  PERL5LIB='$(THREADED_WORLD_TAP_PERL5LIB):$(abs_top_srcdir)/$(1)':$${PERL5LIB} \
	  $(THREADED_WORLD_PROVE) -I '$(abs_top_srcdir)'/src/test/perl -I '$(abs_top_srcdir)/$(1)' $(PROVE_FLAGS) $(2)
endef

define threaded_world_prove_fresh_locale_c
	rm -rf '$(abs_top_srcdir)/$(1)'/tmp_check
	$(MKDIR_P) '$(abs_top_srcdir)/$(1)'/tmp_check/log
	cd '$(abs_top_srcdir)/$(1)' && \
	  unset INITDB_TEMPLATE && \
	  LC_CTYPE=C \
	  TESTLOGDIR='$(abs_top_srcdir)/$(1)'/tmp_check/log \
	  TESTDATADIR='$(abs_top_srcdir)/$(1)'/tmp_check \
	  PATH='$(abs_top_builddir)'/tmp_install$(bindir):'$(abs_top_srcdir)/$(1)':$$PATH \
	  $(call add_to_path,$(strip $(ld_library_path_var)),$(abs_top_builddir)/tmp_install$(libdir)) \
	  TEMP_CONFIG='$(THREADED_WORLD_TAP_CONFIG)' \
	  PG_TEST_EXTRA='$(PG_TEST_EXTRA)' \
	  PGPORT=65432 \
	  top_builddir='$(abs_top_builddir)' \
	  PG_REGRESS='$(abs_top_builddir)'/src/test/regress/pg_regress \
	  REGRESS_SHLIB='$(abs_top_builddir)'/src/test/regress/regress$(DLSUFFIX) \
	  TEST_EXT_LIB='$(THREADED_WORLD_TEST_EXT_LIB)' \
	  share_contrib_dir='$(abs_top_builddir)'/tmp_install$(datadir)/$(datamoduledir) \
	  GMAKE='$(MAKE)' \
	  with_icu='$(with_icu)' \
	  with_ssl='$(with_ssl)' \
	  with_gssapi='$(with_gssapi)' \
	  with_krb_srvnam='$(with_krb_srvnam)' \
	  with_readline='$(with_readline)' \
	  with_ldap='$(with_ldap)' \
	  with_libcurl='$(with_libcurl)' \
	  with_python='$(with_python)' \
	  enable_injection_points='$(enable_injection_points)' \
	  OPENSSL='$(OPENSSL)' \
	  PYTHON='$(PYTHON)' \
	  TAR='$(TAR)' \
	  GZIP_PROGRAM='$(GZIP)' \
	  LZ4='$(LZ4)' \
	  ZSTD='$(ZSTD)' \
	  PERL5LIB='$(THREADED_WORLD_TAP_PERL5LIB):$(abs_top_srcdir)/$(1)':$${PERL5LIB} \
	  $(THREADED_WORLD_PROVE) -I '$(abs_top_srcdir)'/src/test/perl -I '$(abs_top_srcdir)/$(1)' $(PROVE_FLAGS) $(2)
endef

check-tests check-threaded check-threaded-workers check-threaded-smoke check-threaded-150 check-threaded-200: | temp-install
check check-tests check-threaded check-threaded-workers check-threaded-smoke check-threaded-150 check-threaded-200 installcheck installcheck-parallel installcheck-tests: CHECKPREP_TOP=src/test/regress
check check-tests check-threaded check-threaded-workers check-threaded-smoke check-threaded-150 check-threaded-200 installcheck installcheck-parallel installcheck-tests: submake-generated-headers
	$(MAKE) -C src/test/regress $@

